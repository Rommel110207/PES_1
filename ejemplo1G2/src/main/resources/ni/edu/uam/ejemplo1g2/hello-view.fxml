<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejemplo1g2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblSaludo"/>
    <Label fx:id="lblName"/>

    <Label fx:id="lblLastName"/>
    <Label fx:id="lblEmail"/>
    <Label fx:id="lblcellphone"/>

    <TextField fx:id="tfName" layoutX="100.0" layoutY="120" prefWidth="200.0" promptText=" "/>
    <TextField fx:id="tfLastName" layoutX="100.0" layoutY="120" prefWidth="200.0" promptText=" "/>
    <TextField fx:id="tfEmail" layoutX="100.0" layoutY="120" prefWidth="200.0" promptText=" "/>
    <TextField fx:id="tfcellphone" layoutX="100.0" layoutY="120" prefWidth="200.0" promptText=" "/>
    <Button text="Enviar" onAction="#onHelloButtonClick"/>
</VBox>
