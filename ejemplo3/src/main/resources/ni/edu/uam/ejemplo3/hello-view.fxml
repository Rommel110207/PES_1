<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.ejemplo3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Ingrese el salario:" />
        <TextField fx:id="txtSalario" promptText="0.00" />
        <Button onAction="#onCalcularClick" text="Calcular" />
        <Label fx:id="lblSeguro" text="Seguro (7%): $0.0" />
        <Label fx:id="lblBono" text="Bono: $0.0" />
        <Label fx:id="lblNeto" text="Salario Neto: $0.0" />
    </children>
</VBox>